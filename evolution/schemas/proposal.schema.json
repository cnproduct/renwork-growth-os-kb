{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrenn.com/schemas/skill-evolution-proposal-v1.json",
  "title": "RenWork Atomic Skill Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "iteration_id", "target_skill", "change_type", "motivating_pattern_ids", "source_trace_ids", "diff_sha256", "created_at", "created_by", "status"],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"},
    "iteration_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"},
    "target_skill": {"type": "string", "pattern": "^[a-z0-9-]{2,63}$"},
    "change_type": {"enum": ["create", "patch"]},
    "motivating_pattern_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_trace_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"},
    "status": {"const": "candidate"}
  }
}
